+	/** SOS-23 spike: run a GL job; while it runs, the GL thread is the simulation thread if the job came from it.
+	 * The submitting thread waits for the job, so no other simulation draws happen meanwhile. */
+	private static void sosmpDoJob(GlJob j) {
+		if (!j.sosmpSim) {
+			j.doJob();
+			return;
+		}
+		Thread prev = SosMpDeterminism.simThread;
+		SosMpDeterminism.simThread = Thread.currentThread();
+		try {
+			j.doJob();
+		} finally {
+			SosMpDeterminism.simThread = prev;
+		}
+	}
+
