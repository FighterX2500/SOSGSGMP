--- a/snake2d/SosMpDeterminism.java
+++ b/snake2d/SosMpDeterminism.java
@@ -0,0 +1,60 @@
+package snake2d;
+
+/**
+ * SOS-11 spike switches (not game code). All off = vanilla behaviour.
+ * Set by the spike harness through reflection.
+ */
+public final class SosMpDeterminism {
+
+	/** Fixed simulation step in seconds; 0 = vanilla variable step. */
+	public static double fixedStep = 0;
+	/** Run the battle worker threads' jobs inside the simulation step instead of on their own threads. */
+	public static boolean syncThreads = false;
+	/** True while a battle thread job runs inside the simulation step (sync mode). */
+	public static boolean syncJob = false;
+	/** Compute paths on the calling thread instead of the path worker thread. */
+	public static boolean syncPaths = false;
+	/** Separate random streams: simulation draws vs everything else (render, UI, saving). */
+	public static boolean splitRnd = false;
+	/** True while the simulation step runs (set by the game loop, or by the harness during generation). */
+	public static boolean inSim = false;
+	/** Number of draws from the simulation stream. */
+	public static long simDraws = 0;
+	/** The thread that runs the simulation step; draws from any other thread go to the cosmetic stream. */
+	public static Thread simThread;
+	/** Draws made by other threads while the simulation step ran. */
+	public static long foreignDraws = 0;
+	/** SOS-23: in the city view too, update only the systems a battle updates (world, factions, events... held still). */
+	public static boolean freezeWorld = false;
+	/** SOS-23: when not 0, loading a save runs on the simulation stream seeded with this (load = part of the simulation). */
+	public static long loadSeed = 0;
+	/** SOS-23: steps the game may still run before it holds (-1 = no limit); the harness saves at that exact step. */
+	public static long stepsLeft = -1;
+	/** SOS-23: path worker jobs requested, and nanoseconds spent on them on the simulation thread (sync mode). */
+	public static long pathJobs = 0;
+	public static long pathNanos = 0;
+	/** When not null, every simulation draw appends its callers here (debugging only, allocates). */
+	public static StringBuilder trace;
+
+	public static void traceDraw() {
+		trace.append(simDraws).append(':');
+		traceStack(new Throwable().getStackTrace(), 3);
+	}
+
+	public static void traceEvent(String label) {
+		trace.append(label).append(" @").append(simDraws).append(':');
+		traceStack(new Throwable().getStackTrace(), 2);
+	}
+
+	private static void traceStack(StackTraceElement[] st, int from) {
+		for (int i = from; i < Math.min(st.length, from + 9); i++) {
+			if (st[i].getClassName().equals("game.GAME"))
+				break; // the frames above the game update differ per frame and say nothing
+			trace.append(' ').append(st[i].getClassName()).append('.').append(st[i].getMethodName()).append(':').append(st[i].getLineNumber());
+		}
+		trace.append('\n');
+	}
+
+	private SosMpDeterminism() {
+	}
+}
